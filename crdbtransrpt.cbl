IDENTIFICATION DIVISION.
PROGRAM-ID. CRDBRPT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT REPORT-FILE ASSIGN TO REPORTDD
    ORGANIZATION IS SEQUENTIAL 
    ACCESS MODE IS SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD REPORT-FILE
    RECORD CONTAINS 132 CHARACTERS
    BLOCK CONTAINS 0 RECORDS.

01 REPORT-REC PIC X(132).

WORKING-STORAGE SECTION.

01 WS-END-OF-CURSOR PIC X VALUE 'N'.
01 WS-PAGE-NO       PIC 9(5) VALUE 0.
01 WS-LINE-NO       PIC 9(2) VALUE 0.

01 WS-CURRENT-ACCOUNT PIC X(10).
01 WS-PREVIOUS-ACCOUNT PIC X(10).

01 WS-DEBIT-TOTAL  PIC 9(13)V99 COMP-3 VALUE 0.
01 WS-CREDIT-TOTAL PIC 9(13)V99 COMP-3 VALUE 0.

01 WS-GRAND-DEBIT  PIC 9(13)V99 COMP-3 VALUE 0.
01 WS-GRAND-CREDIT PIC 9(13)V99 COMP-3 VALUE 0.

01 WS-DATE        PIC X(10) VALUE '13-10-2026'.
01 WS-AMOUNT-EDIT PIC ZZ,ZZZ,ZZZ,ZZ9.99.

//**********************************************
//***** REPORT HEADER **************************
//**********************************************

01 WS-PAGE-HEADER.
    05 FILLER   PIC X(10).
    05 FILLER   PIC X(20) VALUE 'BANK TRANSACTION REPORT.'
    05 FILLER   PIC X(15).
    05 FILLER   PIC X(6) VALUE 'DATE :'.
    05 OUT-DATE PIC X(10).
    05 FILLER   PIC X(10).
    05 FILLER   PIC X(7) VALUE 'PAGE :'.
    05 OUT-PAGE PIC ZZZZ9.

//***************************************************
//*     HOST VARIABLES  ****************************
//***************************************************
EXEC SQL
    INCLUDE SQLCA
END-EXEC.

01 HV-ACCOUNT-NO  PIC X(10).
01 HV-TRAN-DATE   PIC X(10).
01 HV-TRAN-TYPE   PIC X.
01 HV-TRAN-AMOUNT PIC S9(11)V99 COMP-3.
01 HV-DESC        PIC X(30).

EXEC SQL
    DECLAR TRAN-CURSOR CURSOR FOR
        SELECT ACCOUNT_NO,
               TRAN_DATE,
               TRAN_TYPE,
               TRAN_AMOUNT,
               DESC
        FROM BANK_TRANSACTION
        WHERE TRAN_DATE = :HV-TRAN-DATE
        ORDER BY ACCOUNT_NO, TRAN_DATE
END-EXEC.

PROCEDURE DIVISION.
0000-MAIN-PARA.

    PERFORM 1000-INITIALIZE
    PERFORM 2000-OPEN-CURSOR
    PERFORM 3000-PROCESS UNTIL 
            WS-END-OF-CURSOR = 'Y'
    PERFORM 4000-WRITE-GRAND-TOTAL
    PERFORM 5000-TERMINATE
STOP RUN.

1000-INITIALIZE
    OPEN OUTPUT REPORT-FILE
    MOVE FUNCTION CURRENT-DATE(1:8) TO  
            HV-TRAN-DATE
//* MOVE '13-10-2026' TO HV-TRAN-DATE

    PERFORM 1100-WRITE-HEADER.

1100-WRITE-HEADER.
    ADD 1 TO WS-PAGE-NO

    MOVE WS-PAGE-NO TO OUT-PAGE
    MOVE WS-DATE TO OUT-DATE

    MOVE WS-PAGE-HEADER TO REPORT-REC
    WRITE REPORT-REC

    MOVE ALL '=' TO REPORT-REC
    WRITE REPORT-REC

    MOVE 'ACCOUNT   TYPE  AMOUNT   DESCRIPTION'
        TO REPORT-REC
    WRITE REPORT-REC

    MOVE ALL '-' TO REPORT-REC
    WRITE REPORT-REC

2000-OPEN-CURSOR.
    EXEC SQL
        OPEN TRAN-CURSOR
    END-EXEC.

    IF SQLCODE NOT = 0
        DISPLAY 'CURSOR OPEN FAILED.'
        DISPLAY 'SQLCODE: ' SQLCODE
        MOVE 'Y' TO WS-END-OF-CURSOR
    END-IF.

3000-PROCESS.
    EXEC SQL
        FETCH TRAN-CURSOR
         INTO :HV-ACCOUNT_NO,
              :HV-TRAN-DATE,
              :HV-TRAN-TYPE,
              :HV-TRAN-AMOUNT
              :HV-DESC
    END-EXEC.

    EVALUATE TRUE
         WHEN SQLCODE = 0
            PERFORM 3100-PROCESS-TRANSACTION
         WHEN SQLCODE = 100
            MOVE 'Y' TO WS-END-OF-CURSOR
         WHEN OTHER
            DISPLAY 'FETCH ERROR OCCURED.'
            DISPLAY 'SQLCODE: ' SQLCODE
            MOVE 'Y' TO WS-END-OF-CURSOR
    END-EVALUATE.

3100-PROCESS-TRANSACTION.





