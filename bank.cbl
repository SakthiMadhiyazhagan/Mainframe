IDENTIFICATION DIVISION.
PROGRAM-ID. BANKSYS.

ENVIRONMENT DIVISION.
INPUT-OUT SECTION.
FILE-CONTROL.
	SELECT ACCOUNT-FILE ASSIGN TO "accounts.dat"
	ORGANIZATION IS INDEXED
	ACCESS MODE IS DYNAMIC
	RECORD KEY IS ACCOUNT-NO
	FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD ACCOUNT-FILE.
01 ACCOUNT-RECORD.
	05 ACCOUNT-NO	PIC 9(6).
	05 ACCOUNT-NAME	PIC X(30).
	05 ACCOUNT-BAL	PIC S9(9)V99.
WORKING-STORAGE SECTION.
01 WS-FILE-STATUS	PIC XX.
01 WS-AMOUNT-IN		PIC X(15).
01 WS-AMOUNT		PIC S9(9)V99.
01 WS-ACCOUNT-IN	PIC 9(6).
01 WS-CHOICE		PIC 9 VALUE 0.
01 WS-COUNT		PIC 9(5) VALUE 0.
01 WS-EOF		PIC X VALUE 'N'.
   88 END-OF-FILE 	VALUE 'Y'.
01 WS-DISPLAY-BAL	PIC -,---,---,--9.99.

PROCEDURE DIVISION.
MAIN-PARA.
	PERFORM OPEN-FILE-PARA 
	PERFORM UNTIL WS-CHOICE = 6
	    PERFORM SHOW-MENU
	    EVALUATE WS-CHOICE
		WHEN 1 PERFORM CREATE-ACCOUNT
		WHEN 2 PERFORM DEPOSITE-AMOUNT
		WHEN 3 PERFORM WITHDRAW-AMOUNT
		WHEN 4 PERFORM CHECK-BALANCE
		WHEN 5 PERFORM LIST-ACCOUNTS
		WHEN 6 DISPLAY "THANK YOU FOR BANKING WITH US."
	    END-EVALUATE
	END-PERFORM
	CLOSE ACCOUNT-FILE
	STOP-RUN.

1000-OPEN-FILE-PARA.
	OPEN I-O ACCOUNT-FILE
	IF WS-FILE-STATUS == '35'
	   OPEN OUTPUT ACCOUNT-FILE
	   CLOSE ACCOUNT-FILE
	   OPEN I-O ACCOUNT-FILE
	END-IF
	IF WS-FILE-STATUS NOT = '00'
	   DISPLAY 'CAN'T OPEN THE ACCOUNT FILE. FILE STATUS CODE IS: ' WS-FILE-STATUS
	END-IF. 
	
2000-SHOW-MENU.
	DISPLAY " "
	DISPLAY "========== BANK MENU =========="
	DISPLAY "1. CREATE ACCOUNT"
	DISPLAY "2. DEPOSITE AMOUNT"
	DISPLAY "3. WITHDRAW AMOUNT"
	DISPLAY "4. CHECK BALANCE"
	DISPLAY "5. LIST ACCOUNTS"
	DISPLAY "6. EXIT"
	DISPLAY "ENTER YOUR CHOICE: " WITH NO ADVANCING
	ACCEPT WS-CHOICE.

CREATE-ACCOUNT. 
	DISPLAY "ENTER ACCOUNT NUMBER: " WITH NO ADVANCING
	ACCEPT WS-ACCOUNT-IN
	MOVE WS-ACCOUNT-IN TO ACCOUNT-NO
	DISPLAY "ACCOUNT HOLDER NAME: " WITH NO ADVANCING
	ACCEPT ACCOUNT-NAME
	DISPLAY "OPENING DEPOSITE AMOUNT: " WITH NO ADVANCING
	PERFORM GET-AMOUNT
	    IF WS-AMOUNT < 0
		DISPLAY "OPENING DEPOSITE CAN'T BE NEGATIVE."
	    ELSE
		MOVE WS-AMOUNT TO ACCOUNT-BAL
		WRITE ACCOUNT-RECORD
		    INVALID-KEY
			DISPLAY "Account Number already exist."
		    NOT INVALID KEY
			DISPLAY "Account Created Successfully."
		END-WRITE
	    END-IF.



GET-AMOUNT.
	DISPLAY "ENTER DEPOSITE AMOUNT: " WITH NO ADVANCING
	ACCEPT WS-AMOUNT-IN
	COMPUTE WS-AMOUNT = FUNCTION NUMVAL(WS-AMOUNT-IN).
